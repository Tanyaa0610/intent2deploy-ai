# ShopFlow local development configuration.
# Copy to .env and adjust if needed — all values have safe local defaults,
# so running without a .env file at all also works.

# SQLite file path. Use ":memory:" for an ephemeral in-process database.
SHOPFLOW_DB_PATH=shopflow.db

# Session token lifetime, in seconds.
SHOPFLOW_SESSION_TTL_SECONDS=3600

# Password-reset token lifetime, in seconds.
SHOPFLOW_RESET_TOKEN_TTL_SECONDS=900

# Inventory quantity at or below which a low-stock notification fires.
SHOPFLOW_LOW_STOCK_THRESHOLD=5

# Maximum quantity of a single product allowed in one cart/order line.
SHOPFLOW_MAX_QUANTITY_PER_PRODUCT=10

# Seed demo data (admin + customer users, sample products) on startup.
SHOPFLOW_SEED_ON_STARTUP=true
