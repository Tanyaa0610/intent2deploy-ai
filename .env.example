APP_ENV=development

# --- LLM Provider Abstraction --------------------------------------------
# LLM_PROVIDER: anthropic | openai | local
# LLM_MODE: mock | live
#   mock  -> deterministic LocalProvider, no API key required. Real RAG
#            retrieval still runs; only the generative step is templated
#            from retrieved evidence.
#   live  -> calls the configured provider's real API. Requires an API key.
LLM_PROVIDER=anthropic
LLM_MODE=mock
MODEL_NAME=claude-sonnet-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- GitHub ----------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- Vector store ------------------------------------------------------------
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./chroma_data

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///./intent2deploy.db

# --- Safety / limits ---------------------------------------------------------
MAX_FILES_CHANGED=15
MAX_PATCH_LINES=1000
MAX_REPAIR_ATTEMPTS=2
COMMAND_TIMEOUT_SECONDS=120

# --- Workspaces ----------------------------------------------------------------
WORKSPACES_DIR=./workspaces

# --- Sweep.dev (optional external automation adapter; unused unless set) -----
SWEEP_API_KEY=
